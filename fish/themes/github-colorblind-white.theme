# github-colorblind-white — GitHub Light mode, colorblind-accessible palette
# Basado en los colores oficiales de GitHub para modo claro con enfoque daltónico
# https://github.com/primer/primitives

set --global fish_color_normal 1f2328
set --global fish_color_command 0969da
set --global fish_color_keyword bf3989
set --global fish_color_quote 9a6700
set --global fish_color_redirection 1f2328
set --global fish_color_end 9a6700
set --global fish_color_error cf222e
set --global fish_color_param 8250df
set --global fish_color_comment 656d76
set --global fish_color_selection --background=ddf4ff
set --global fish_color_search_match --background=ddf4ff
set --global fish_color_operator 1a7f37
set --global fish_color_escape bf3989
set --global fish_color_autosuggestion 8c959f
set --global fish_color_cancel --reverse
set --global fish_color_cwd 1a7f37
set --global fish_color_cwd_root cf222e
set --global fish_color_host 1f2328
set --global fish_color_host_remote 9a6700
set --global fish_color_status cf222e
set --global fish_color_user 0969da
set --global fish_color_valid_path --underline

set --global fish_pager_color_progress 656d76
set --global fish_pager_color_prefix 0969da
set --global fish_pager_color_completion 1f2328
set --global fish_pager_color_description 656d76
set --global fish_pager_color_selected_background --background=ddf4ff